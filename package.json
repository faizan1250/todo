{
  "name": "todo-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "bun --filter @todo/backend dev",
    "dev:frontend": "bun --filter @todo/frontend dev",
    "build:frontend": "bun --filter @todo/frontend build",
    "lint:frontend": "bun --filter @todo/frontend lint",
    "typecheck:frontend": "bun --filter @todo/frontend typecheck",
    "build": "bun --filter '*' build",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "bun --filter '*' lint",
    "test": "bun --filter '*' test"
  }
}
